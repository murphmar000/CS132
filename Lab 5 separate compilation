#include <iostream>
#include <vector>
#include "Food.h"

using namespace std;
using namespace food;

int main() {
  Food orange("Orange", 45, {"sweet", "tart"});
  Food honey("Honey", 64, {"sweet", "floral"});
  Food apple("Apple", 95, {"sweet", "crisp"});
  Food tomato("Tomato", 22, {"savory", "fresh"});

  vector<Food> foods = {orange, honey, apple, tomato};
  string inputFlavor;

  while (true) {
    cout << "\nEnter a flavor to search for it (or 'exit' to quit): ";
    cin >> inputFlavor;

    if (inputFlavor == "exit") break;

    bool found = false;
    for (const Food& f : foods) {
      if (f.hasFlavor(inputFlavor)) {
        cout << f.name << "\n" << f.getCalorieCount() << " calories\n";
        found = true;
      }
    }
    if (!found) {
      cout << "No food with that flavor.\n";
    }
}

  Food combined = orange + honey;
  cout << "\nCombined Food: " << combined.name << " - " <<
combined.getCalorieCount() << " calories\n";

return 0;
}
