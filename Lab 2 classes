#include <iostream>
#include <vector>
using namespace std;

class Food {
public:
    Food(string name, int calories, vector<string> flavors){
        this->name = name;
        this->calories = calories;
        this->flavors = flavors;
    }
    
    int getCalorieCount(){
        return calories;
    }
    
    bool hasFlavor(string flavor){
        for (string f : flavors) {
            if (f == flavor) {
                return true;
            }
        }
        return false;
    }
    string name;
    
private:
    int calories;
    vector<string> flavors;
};

int main() {
    Food orange("Orange", 45, {"sweet", "tart"});
    Food honey("Honey", 64, {"sweet", "floral"});
    Food apple("Apple", 95, {"sweet", "crisp"});
    Food tomato("Tomato", 22, {"savory", "fresh"});
    
    vector<Food> foods = {orange, honey, apple, tomato};
    string inputFlavor;
    while (true) {
        cout << "\nEnter a flavor to search for it: ";
        cin >> inputFlavor;
        
        if (inputFlavor == "exit") break;
        
        bool found = false;
        for (Food f : foods) {
            if (f.hasFlavor(inputFlavor)) {
                cout << f.name << "\n" << f.getCalorieCount() << " calories\n";
                found = true;
            }
        }
        if (!found){
            cout << "No food with that flavor.\n";
        }
    }
    
    return 0;
}
